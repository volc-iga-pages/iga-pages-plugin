{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/check-dev-command.mjs\" cursor"
      }
    ],
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/session-start-telemetry.mjs\" cursor",
        "timeout": 5
      }
    ]
  }
}
